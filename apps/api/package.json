{
  "name": "@shopcart/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env --import ./dist/telemetria.js dist/server.js",
    "test": "vitest run",
    "test:integracion": "vitest run --config vitest.integracion.config.ts",
    "test:cobertura": "vitest run --config vitest.cobertura.config.ts --coverage",
    "test:concurrencia": "vitest run --config vitest.concurrencia.config.ts",
    "test:humo": "vitest run --config vitest.humo.config.ts",
    "test:entorno": "vitest run --config vitest.entorno.config.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "@types/pdfmake": "0.3.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.1",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-pino": "0.69.0",
    "@opentelemetry/instrumentation-tedious": "0.42.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@shopcart/shared": "workspace:*",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "import-in-the-middle": "3.5.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "mssql": "^12.7.13",
    "pdfmake": "0.3.13",
    "pino": "^10.4.0",
    "rate-limiter-flexible": "^11.2.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  }
}
