{
  "name": "@shopcart/migrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrar": "node --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrar:pruebas": "node --env-file-if-exists=../../.env src/index.ts --pruebas",
    "ledger:verificar": "node --env-file-if-exists=../../.env src/verificar-ledger.ts",
    "test": "vitest run",
    "test:integracion": "vitest run --config vitest.integracion.config.ts",
    "test:cobertura": "vitest run --coverage"
  },
  "dependencies": {
    "mssql": "^12.7.13",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  }
}
