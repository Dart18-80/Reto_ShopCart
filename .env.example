# Copia este archivo como .env y cambia los valores marcados como EJEMPLO.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.
# Cada valor tiene una sola fuente: Compose, el migrador y la API leen estas mismas variables.
# En docker-compose.yml, las réplicas de la API solo reemplazan DB_HOST=sqlserver y REDIS_HOST=redis.

# --- SQL Server ---
# EJEMPLO: contraseña del administrador (sa). SQL Server exige mínimo 8 caracteres
# con mayúsculas, minúsculas, números y símbolos. Evita el símbolo $ (Compose lo interpreta).
MSSQL_SA_PASSWORD=EJEMPLO_Cambiar_Sa_2026!
# Memoria máxima de SQL Server en MB (RAM estimada en docs/01-arquitectura.md §3).
MSSQL_MEMORY_LIMIT_MB=2048
# Host y puerto para conectarse desde el host (SSMS, pruebas, API fuera de Docker).
# El contenedor escucha y se publica en este mismo puerto, solo en 127.0.0.1.
DB_HOST=localhost
DB_PORT=1433
# Base que crea y migra db-migrator y que usa la API. Para la base de pruebas usa
# DB_NOMBRE=shopcart_test solo en ese comando (ver README), no aquí.
DB_NOMBRE=ShopCart
# Login de la API: debe ser shopcart_app (solo EXECUTE, DENY de SELECT/INSERT/UPDATE/DELETE).
# El migrador lo crea con DB_CONTRASENA y V001 le asigna los permisos por nombre.
DB_USUARIO=shopcart_app
# EJEMPLO: contraseña del login de la API.
DB_CONTRASENA=EJEMPLO_Cambiar_App_2026!
# EJEMPLO: contraseña del login del migrador (shopcart_migrator: db_owner de la base, sin permisos de servidor).
DB_MIGRADOR_CONTRASENA=EJEMPLO_Cambiar_Migrador_2026!
# Acepta el certificado autofirmado de SQL Server local. En un servidor con certificado válido, false.
DB_CONFIAR_CERTIFICADO=true
# Timeouts de la API hacia SQL Server, en milisegundos. Conexión: 2000 (dentro de la subred tarda
# milisegundos y el health con la base caída responde antes del timeout de 3 s del healthcheck).
# Consulta: 15000 (el valor por defecto de mssql).
DB_TIMEOUT_CONEXION_MS=2000
DB_TIMEOUT_CONSULTA_MS=15000

# --- Redis ---
# Host y puerto desde el host; el contenedor escucha y se publica en este mismo puerto, solo en 127.0.0.1.
REDIS_HOST=localhost
REDIS_PORT=6379
# EJEMPLO: contraseña de Redis (requirepass).
REDIS_CONTRASENA=EJEMPLO_Cambiar_Redis_2026
# Opcional (0 por defecto). Las pruebas de integración usan la base 1 y la vacían al arrancar.
# REDIS_BASE_DATOS=0

# --- API ---
# development | test | production. Solo cambia la validación de secretos: en production la API
# rechaza los marcados como EJEMPLO. Nunca expone detalles de errores ni relaja otra medida.
NODE_ENV=development
# Puerto HTTP y nombre de la réplica (header X-Instancia) cuando la API corre fuera de Docker.
# En Compose las réplicas usan siempre el puerto 3000 (nginx apunta ahí) y se llaman api-1 y api-2.
PUERTO=3000
INSTANCIA_ID=local
LOG_LEVEL=info
# EJEMPLO: secreto con el que se firman los access tokens (HS256, A-07). Mínimo 32 caracteres; en
# producción la API rechaza este valor de ejemplo. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=EJEMPLO_Cambiar_Secreto_JWT_de_al_menos_32_caracteres

# Orígenes permitidos por CORS, separados por coma (servidor de desarrollo de Vite).
CORS_ORIGINS=http://localhost:5173

# --- Web (nginx) ---
# IP donde se publica http://<WEB_IP>:8080. 127.0.0.1 solo lo expone a esta máquina; 0.0.0.0 lo
# expone a toda la red local (por ejemplo, para mostrar la demo desde otro dispositivo).
WEB_IP=127.0.0.1

# --- Red de Docker ---
# Primeros tres octetos de la subred de Compose (A-03): los servicios usan IPs fijas de <prefijo>.2 a
# <prefijo>.127. Cámbialo solo si 172.28.10.0/24 choca con otra red de tu máquina.
RED_PREFIJO=172.28.10

# --- Exportaciones (A-24) ---
# Directorio del almacén de archivos exportados cuando la API corre fuera de Docker (por defecto
# .almacen/exportaciones). En Docker, las réplicas usan el volumen compartido "exportaciones".
# ALMACEN_DIR=.almacen/exportaciones
