# Copia este archivo como .env y cambia los valores marcados como EJEMPLO.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.

# --- SQL Server ---
# EJEMPLO: contraseña del administrador (sa). SQL Server exige mínimo 8 caracteres
# con mayúsculas, minúsculas, números y símbolos. Evita el símbolo $ (Compose lo interpreta).
MSSQL_SA_PASSWORD=EJEMPLO_Cambiar_Sa_2026!
# Memoria máxima de SQL Server en MB (RAM estimada en docs/01-arquitectura.md §3).
MSSQL_MEMORY_LIMIT_MB=2048
# Puerto expuesto en el host (para SSMS, Azure Data Studio y las pruebas de integración).
SQLSERVER_PUERTO=1433

# --- Redis ---
# Puerto expuesto en el host.
REDIS_PUERTO=6379

# --- Migrador y logins de la base (E0-H03) ---
# Base que crea y migra db-migrator. Para la base de pruebas usa DB_NOMBRE=shopcart_test
# solo en ese comando (ver README), no aquí.
DB_NOMBRE=ShopCart
# EJEMPLO: contraseña del login de la API (shopcart_app: solo EXECUTE, DENY de SELECT/INSERT/UPDATE/DELETE).
DB_APP_CONTRASENA=EJEMPLO_Cambiar_App_2026!
# EJEMPLO: contraseña del login del migrador (shopcart_migrator: db_owner de la base, sin permisos de servidor).
DB_MIGRADOR_CONTRASENA=EJEMPLO_Cambiar_Migrador_2026!
# Acepta el certificado autofirmado de SQL Server local. En un servidor con certificado válido, false.
DB_CONFIAR_CERTIFICADO=true

# --- API (E0-H04) ---
# development | test | production. En production, la API rechaza los secretos marcados como EJEMPLO.
NODE_ENV=development
# Puerto HTTP de la API y nombre de la réplica (header X-Instancia).
PUERTO=3000
INSTANCIA_ID=local
LOG_LEVEL=info
# Orígenes permitidos por CORS, separados por coma (servidor de desarrollo de Vite).
CORS_ORIGINS=http://localhost:5173
# EJEMPLO: Redis exige contraseña (requirepass). Va dentro de la URL: redis://:<contraseña>@host:puerto.
# Usa solo letras, números, _ y - en la contraseña (otros caracteres deben codificarse en la URL).
REDIS_URL=redis://:EJEMPLO_Cambiar_Redis_2026@localhost:6379
