{
  "name": "shopcart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && pnpm openapi:verificar",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "db:migrar": "pnpm --filter @shopcart/migrator migrar",
    "ledger:verificar": "pnpm --filter @shopcart/migrator ledger:verificar",
    "test:integracion": "pnpm --filter @shopcart/migrator test:integracion && pnpm --filter @shopcart/migrator migrar:pruebas && pnpm --filter @shopcart/api test:integracion",
    "test:cobertura": "pnpm --filter @shopcart/migrator migrar:pruebas && pnpm --filter @shopcart/api test:cobertura",
    "test:concurrencia": "pnpm --filter @shopcart/api test:concurrencia",
    "test:entorno": "pnpm --filter @shopcart/api test:entorno",
    "test:humo": "docker compose build api-1 && pnpm --filter @shopcart/api test:humo",
    "openapi:exportar": "pnpm --filter @shopcart/contrato exportar",
    "openapi:verificar": "pnpm --filter @shopcart/contrato verificar",
    "contrato:cobertura": "pnpm --filter @shopcart/contrato cobertura",
    "test:e2e": "pnpm --filter @shopcart/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
